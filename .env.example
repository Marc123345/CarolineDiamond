# Shopify Store Configuration
# Copy this file to .env and fill in your actual values

# Your Shopify store domain (without https://)
VITE_SHOPIFY_STORE_DOMAIN=uyccca-1e.myshopify.com

# Shopify Storefront API Access Token
# Get from: Shopify Admin → Settings → Apps and sales channels → Develop apps
# Required permissions: Read products, Read product listings
VITE_SHOPIFY_STOREFRONT_ACCESS_TOKEN=your-storefront-access-token-here

# Shopify Admin API Access Token
# Get from: Shopify Admin → Settings → Apps and sales channels → Develop apps
# Required permissions: write_products, read_products
SHOPIFY_ADMIN_ACCESS_TOKEN=your-admin-access-token-here

# Instructions to get these tokens:
# 1. Log into Shopify Admin: https://uyccca-1e.myshopify.com/admin
# 2. Go to Settings → Apps and sales channels → Develop apps
# 3. Create a custom app or select your existing app
# 4. Configure API scopes:
#    - Admin API: write_products, read_products
#    - Storefront API: Read products, Read product listings
# 5. Install the app to your store
# 6. Copy the access tokens to this file
